{
  "manifest_version": 3,
  "name": "Browser Lag Fix",
  "version": "1.0.0",
  "description": "Stops websites from reserving huge files in browser site storage, which can freeze Windows PCs and leak your disk size.",
  "minimum_chrome_version": "111",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": {
    "default_title": "Browser Lag Fix",
    "default_popup": "src/ui/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_ui": { "page": "src/ui/options.html", "open_in_tab": true },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
